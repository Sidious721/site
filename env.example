# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не должен попадать в git — добавьте его в .gitignore.

PORT=3000

# Домен, с которого разрешено слать запросы (ваш сайт). В деве можно оставить *
ALLOWED_ORIGIN=https://your-domain.example

# --- Email: через что отправляется письмо ---
# ВАЖНО: отправка идёт через HTTP API Resend, а НЕ через прямой SMTP.
# Причина: бесплатные тарифы большинства облачных хостингов (включая Render,
# с сентября 2025) блокируют исходящий SMTP-трафик (порты 25/465/587) на уровне
# платформы — с любыми верными данными почта оттуда просто не уйдёт, попытка
# будет молча "висеть". HTTP API (порт 443, обычный HTTPS) этой блокировке
# не подвержен.
#
# Как получить RESEND_API_KEY:
# 1. Зарегистрируйтесь на resend.com (бесплатно, 3000 писем/месяц).
# 2. В панели → API Keys → Create API Key → скопируйте ключ (начинается с re_).
RESEND_API_KEY=re_ваш_ключ_сюда

# Адрес отправителя. Можно оставить как есть для старта — onboarding@resend.dev
# работает сразу, без подтверждения домена (ограничение только на адрес
# ОТПРАВИТЕЛЯ; присылать письма можно на любой реальный адрес получателя).
# Когда захотите слать от своего домена (например, logiq-freight.com) —
# в панели Resend: Domains → Add Domain → пропишите показанные DNS-записи
# у себя (там же, где домен) → после подтверждения замените строку ниже на:
# FROM_EMAIL=LogiQ — заявки с сайта <noreply@logiq-freight.com>
FROM_EMAIL=LogiQ — заявки с сайта <onboarding@resend.dev>

# Куда падает заявка — письмо с формы уходит именно на этот адрес
RFQ_TO_EMAIL=a.egorov@logiq-freight.com
