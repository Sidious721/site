# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не должен попадать в git — добавьте его в .gitignore.

PORT=3000

# Домен, с которого разрешено слать запросы (ваш сайт). В деве можно оставить *
ALLOWED_ORIGIN=https://your-domain.example

# --- SMTP: через что отправляется письмо ---
# Вариант А — Outlook/Office365 (logiq.freight@outlook.com):
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=logiq.freight@outlook.com
SMTP_PASS=пароль_приложения_а_не_обычный_пароль

# Вариант Б — сторонний транзакционный сервис (см. README, раздел "Альтернатива Outlook SMTP")
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxx...

# Вариант В — если для logiq-freight.com уже настроена своя почта (например, тоже
# через Beget/Sweb), можно слать и через неё — тогда SMTP_USER/SMTP_HOST/SMTP_PASS
# берутся из настроек этого почтового ящика, а не из вариантов А/Б выше.

# SMTP_USER — это ящик, ЧЕРЕЗ который письмо технически отправляется (нужен реальный
# пароль/доступ). RFQ_TO_EMAIL — это ящик, КУДА письмо приходит. Они могут быть разными.
RFQ_TO_EMAIL=a.egorov@logiq-freight.com
